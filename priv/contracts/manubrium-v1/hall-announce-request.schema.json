{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/manubrium-v1/hall-announce-request.schema.json",
  "title": "POST /tournaments/:id/hall/announce request",
  "description": "Say something in the hall: a canned announcement or free text, on every announcer that is online.",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [{"required": ["canned"]}, {"required": ["text"]}],
  "properties": {
    "canned": {"type": "string", "enum": ["silence", "phones", "seats", "results", "arbiter"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 300}
  }
}
