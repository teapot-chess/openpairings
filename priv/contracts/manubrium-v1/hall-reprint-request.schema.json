{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/manubrium-v1/hall-reprint-request.schema.json",
  "title": "POST /tournaments/:id/hall/print request",
  "description": "Print again on every print station that is online. The latest published round, always: the stations hold no other.",
  "type": "object",
  "additionalProperties": false,
  "required": ["what"],
  "properties": {
    "what": {"type": "string", "enum": ["pairings", "placecards", "both", "standings", "playerlist", "slips"]}
  }
}
